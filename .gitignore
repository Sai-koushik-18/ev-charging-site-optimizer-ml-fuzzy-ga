# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging
dist/
build/
*.egg-info/
*.egg

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Secrets and local configuration (OCM_API_KEY is read from the environment)
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.yaml

# Test, lint and cache output
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/

# Logs
logs/
*.log

# Large regenerable data (rebuilt by `python run_pipeline.py all`)
data/places/
data/synthetic/
data/samples/
models/

# Raw data: keep only the small campus extracts the dashboard and pipeline need
data/raw/*
!data/raw/osm/
data/raw/osm/*
!data/raw/osm/campus_osm.json
!data/raw/osm/campus_boundary.geojson
!data/raw/osm/buildings.geojson
!data/raw/osm/roads.geojson
!data/raw/osm/parking.geojson
!data/raw/weather/
data/raw/weather/*
!data/raw/weather/weather_hourly_2024.csv
!data/raw/openchargemap/
data/raw/openchargemap/*
!data/raw/openchargemap/stations.geojson

# Outputs: keep the small result files shown in the dashboard and README
outputs/*
!outputs/evaluation/
!outputs/ml_results/
!outputs/ga_results/
!outputs/maps/
outputs/ga_results/checkpoints/
outputs/ga_results/plots/

# Temporary and backup files
*.tmp
*.temp
*.bak
*.backup
*.old
backups/

# Vercel CLI project links
.vercel/
